# AutoMaestro Environment Variables Template (Spain Enterprise Platform)

# PostgreSQL Configuration
POSTGRES_USER=automaestro
POSTGRES_PASSWORD=SecureAutoPass2026!
POSTGRES_DB=automaestro_db
DATABASE_URL=postgresql://automaestro:SecureAutoPass2026!@localhost:5432/automaestro_db?schema=public

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Cloudinary (Gestión de Imágenes)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Vercel / Frontend
NEXT_PUBLIC_SITE_URL="https://www.autirio.com"

# Backend JWT Security Secrets
JWT_SECRET=SuperSecretAutoMaestroJWTKey2026_SpainEnterprise
JWT_REFRESH_SECRET=SuperSecretAutoMaestroRefreshKey2026

# URLs
PORT=4000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
